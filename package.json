{
  "name": "lifewithllm",
  "productName": "LifeWithLLM",
  "desktopName": "LifeWithLLM",
  "private": true,
  "version": "0.1.0",
  "description": "A private local-LLM assistant for research, shopping, and social workflows.",
  "author": {
    "name": "LifeWithLLM",
    "email": "support@lifewithllm.app"
  },
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:convex": "convex dev",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "convex:codegen": "convex dev --once",
    "generate:keys": "node scripts/generateKeys.mjs",
    "desktop:build": "tsc -b && vite build --mode desktop && electron-builder",
    "desktop:dir": "tsc -b && vite build --mode desktop && electron-builder --dir"
  },
  "build": {
    "appId": "com.lifewithllm.desktop",
    "productName": "LifeWithLLM",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": ["dmg", "zip"]
    },
    "win": {
      "target": ["nsis", "zip"]
    },
    "linux": {
      "category": "Utility",
      "target": ["AppImage", "deb"]
    }
  },
  "dependencies": {
    "@auth/core": "^0.41.1",
    "@convex-dev/auth": "^0.0.95",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.44.0",
    "framer-motion": "^13.1.0",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.4.21",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "jose": "^6.0.11",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "vite": "^8.2.1"
  }
}
